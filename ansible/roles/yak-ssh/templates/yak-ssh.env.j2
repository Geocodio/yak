YAK_SSH_URL={{ yak_ssh_url }}
YAK_SSH_TOKEN_FILE=/etc/yak/ssh-token-{{ yak_ssh_env_for }}
{% if yak_ssh_env_for == 'wake' %}
YAK_WAKE_TIMEOUT={{ yak_ssh_wake_timeout }}
{% else %}
YAK_TERMBRIDGE_LISTEN={{ yak_ssh_bridge_listen }}
YAK_TERMBRIDGE_ALLOWED_ORIGINS={{ yak_ssh_allowed_origins }}
{% endif %}
