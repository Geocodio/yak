APP_NAME=Yak
APP_ENV=production
APP_KEY=base64:{{ yak_app_key }}
APP_DEBUG=false
APP_URL=https://{{ yak_domain }}
# Shown on Settings > MCP servers so the terminal fallback is a copyable one-liner.
YAK_SSH_HOST={{ yak_ssh_host | default(yak_domain) }}
# The jump host and port that `yak ssh` gives clients.
YAK_SSH_JUMP_HOST={{ yak_ssh_jump_host | default(yak_domain) }}
YAK_SSH_JUMP_PORT={{ yak_ssh_jump_port | default(2222) }}
# Must match the token the yak-ssh role writes for the wake proxy, key lookup and terminal bridge.
YAK_SSH_INTERNAL_TOKEN={{ yak_ssh_internal_token | default('') }}
YAK_CONTAINER_NAME={{ yak_container_name }}
YAK_DEPLOYMENTS_HOSTNAME_SUFFIX={{ yak_domain }}
# Host Caddy reaches the app through the published port, so /internal/* requests
# arrive from the app network's gateway (or loopback).
YAK_DEPLOYMENTS_INGRESS_IP_CIDR=127.0.0.1/32,{{ yak_app_network_subnet }}
# Cold start has to wait for dockerd inside the freshly-woken container
# and then boot the full compose stack (clickhouse is slow); 60s default
# isn't enough for heavy release-branch previews.
YAK_DEPLOYMENTS_DEFAULT_COLD_START_TIMEOUT_SECONDS=300
# The dashboard session cookie is host-only: no SESSION_DOMAIN, so the
# browser never sends it to *.{{ yak_domain }} previews, which run untrusted
# PR code. The __Host- prefix also stops a preview from planting a
# Domain=.{{ yak_domain }} cookie that shadows it. Previews authenticate
# with their own per-host cookie (see ssl role Caddyfile.j2).
SESSION_COOKIE=__Host-yak-session
SESSION_SECURE_COOKIE=true

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mariadb
DB_HOST=yak-mariadb
DB_PORT=3306
DB_DATABASE=yak
DB_USERNAME=yak
DB_PASSWORD={{ mariadb_password }}

QUEUE_CONNECTION=redis
REDIS_HOST={{ redis_container_name }}
REDIS_PORT=6379
REDIS_PASSWORD={{ redis_password }}

ARTIFACTS_PATH=/data/artifacts

# Claude session transcripts persisted between sandboxes so follow-ups
# can --resume sessions after the original sandbox is destroyed. Must
# live on the /data volume to survive container recreation on deploy.
YAK_SESSION_TRANSCRIPT_PATH=/data/claude-sessions

# Thread runtime. The store key comes from the vault only; the encrypted
# session state lives on the /data volume.
YAK_SESSION_STORE_KEY={{ yak_session_store_key }}
YAK_THREADS_SESSION_STORE_PATH=/data/session-store
YAK_THREADS_CREDENTIAL_SOCKET={{ yak_credentials_path }}/redeem.sock
YAK_THREADS_CREDENTIAL_SOCKET_UID={{ yak_broker_uid }}
YAK_THREADS_CREDENTIAL_SOCKET_DIRECTORY_GID={{ yak_broker_gid }}
YAK_THREADS_AUTH_PROXY_VALIDATION_ADDRESS={{ yak_container_address }}
YAK_THREADS_AUTH_PROXY_URL=http://{{ yak_auth_proxy_address }}

# Reverb runs inside the container on 8080; Caddy routes /app/* and /apps/*
# to it, so browsers connect over 443.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID={{ reverb_app_id }}
REVERB_APP_KEY={{ reverb_app_key }}
REVERB_APP_SECRET={{ reverb_app_secret }}
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=true
VITE_REVERB_APP_KEY={{ reverb_app_key }}
VITE_REVERB_HOST={{ yak_domain }}
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

{% if yak_system_account_admin_ids | default('') | length > 0 %}
YAK_SYSTEM_ACCOUNT_ADMIN_IDS={{ yak_system_account_admin_ids }}
{% endif %}
{% if vapid_public_key | default('') | length > 0 and vapid_private_key | default('') | length > 0 %}
VAPID_SUBJECT={{ vapid_subject | default('mailto:' + (mail_from_address | default('hello@example.com', true)), true) }}
VAPID_PUBLIC_KEY={{ vapid_public_key }}
VAPID_PRIVATE_KEY={{ vapid_private_key }}
{% endif %}
{% if yak_datasets_s3_bucket | default('') | length > 0 %}
YAK_DATASETS_S3_BUCKET={{ yak_datasets_s3_bucket }}
{% if yak_datasets_s3_endpoint | default('') | length > 0 %}
YAK_DATASETS_S3_ENDPOINT={{ yak_datasets_s3_endpoint }}
{% endif %}
{% if yak_datasets_s3_region | default('') | length > 0 %}
YAK_DATASETS_S3_REGION={{ yak_datasets_s3_region }}
{% endif %}
{% if yak_datasets_s3_access_key | default('') | length > 0 %}
YAK_DATASETS_S3_ACCESS_KEY={{ yak_datasets_s3_access_key }}
{% endif %}
{% if yak_datasets_s3_secret | default('') | length > 0 %}
YAK_DATASETS_S3_SECRET={{ yak_datasets_s3_secret }}
{% endif %}
{% if yak_datasets_s3_path_style is defined %}
YAK_DATASETS_S3_PATH_STYLE={{ 'true' if yak_datasets_s3_path_style else 'false' }}
{% endif %}
{% endif %}

ANTHROPIC_API_KEY={{ anthropic_api_key }}

YAK_MCP_CONFIG_PATH=/home/yak/mcp-config.json
{% if agent_extra_env is defined %}
YAK_AGENT_PASSTHROUGH_ENV={{ agent_extra_env.keys() | join(',') }}
{% endif %}

# GitHub App
YAK_GITHUB_APP_ID={{ github_app_id | default('') }}
YAK_GITHUB_PRIVATE_KEY_PATH=/etc/yak/github-app.pem
YAK_GITHUB_INSTALLATION_ID={{ github_installation_id | default('') }}
YAK_GITHUB_WEBHOOK_SECRET={{ github_webhook_secret | default('') }}
YAK_GITHUB_APP_CLIENT_ID={{ github_app_client_id | default('') }}
YAK_GITHUB_APP_CLIENT_SECRET={{ github_app_client_secret | default('') }}

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID={{ google_oauth_client_id }}
GOOGLE_OAUTH_CLIENT_SECRET={{ google_oauth_client_secret }}
GOOGLE_OAUTH_ALLOWED_DOMAINS={{ google_oauth_allowed_domains }}

# Slack
YAK_SLACK_BOT_TOKEN={{ slack_bot_token | default('') }}
YAK_SLACK_SIGNING_SECRET={{ slack_signing_secret | default('') }}
YAK_SLACK_WORKSPACE_URL={{ slack_workspace_url | default('') }}
YAK_SLACK_ALERT_CHANNEL={{ slack_alert_channel | default('') }}

# Linear — OAuth app for outbound comments/state updates (posts as "Yak")
YAK_LINEAR_OAUTH_CLIENT_ID={{ linear_oauth_client_id | default('') }}
YAK_LINEAR_OAUTH_CLIENT_SECRET={{ linear_oauth_client_secret | default('') }}
YAK_LINEAR_OAUTH_REDIRECT_URI={{ linear_oauth_redirect_uri | default('https://' + yak_domain + '/auth/linear/callback') }}
YAK_LINEAR_OAUTH_SCOPES={{ linear_oauth_scopes | default('read,write,app:assignable,app:mentionable') }}
YAK_LINEAR_WEBHOOK_SECRET={{ linear_webhook_secret | default('') }}
YAK_LINEAR_DONE_STATE_ID={{ linear_done_state_id | default('') }}
YAK_LINEAR_CANCELLED_STATE_ID={{ linear_cancelled_state_id | default('') }}
YAK_LINEAR_IN_REVIEW_STATE_ID={{ linear_in_review_state_id | default('') }}

# Sentry
YAK_SENTRY_AUTH_TOKEN={{ sentry_auth_token | default('') }}
YAK_SENTRY_WEBHOOK_SECRET={{ sentry_webhook_secret | default('') }}
YAK_SENTRY_ORG_SLUG={{ sentry_org_slug | default('') }}

# Email channel (Postmark inbound) and outbound mail. Leave
# email_webhook_password blank to keep the channel off.
YAK_EMAIL_WEBHOOK_PASSWORD={{ email_webhook_password | default('') }}
YAK_EMAIL_INBOUND_ADDRESS={{ email_inbound_address | default('') }}
YAK_EMAIL_REPLY_TO={{ email_reply_to | default('') }}
MAIL_MAILER={{ 'postmark' if postmark_api_key | default('') else 'log' }}
POSTMARK_API_KEY={{ postmark_api_key | default('') }}
POSTMARK_MESSAGE_STREAM_ID={{ postmark_message_stream_id | default('outbound', true) }}
MAIL_FROM_ADDRESS={{ mail_from_address | default(email_inbound_address | default('hello@example.com'), true) }}
MAIL_FROM_NAME=Yak

# Drone
YAK_DRONE_URL={{ drone_url | default('') }}
YAK_DRONE_TOKEN={{ drone_token | default('') }}

# Walkthrough voiceover (ElevenLabs text-to-speech). Leave the key blank to
# render walkthroughs captions-only — VoiceoverGenerator skips silently and
# the health page's Voiceover row reports "Off (no ELEVENLABS_API_KEY)".
ELEVENLABS_API_KEY={{ elevenlabs_api_key | default('') }}
ELEVENLABS_VOICE_ID={{ elevenlabs_voice_id | default('UgBBYS2sOqTuMpoF3BR0', true) }}

# Optional: token the /skills page uses to clone private plugin marketplaces.
# Leave blank to use the GitHub App installation token, which already covers
# every repository the app is installed on. Only set it for a marketplace
# outside that installation.
YAK_SKILLS_GITHUB_TOKEN={{ yak_skills_github_token | default('') }}
{% if agent_extra_env is defined %}

# Extra environment variables for the agent process
{% for key, value in agent_extra_env.items() %}
{{ key }}={{ value }}
{% endfor %}
{% endif %}
{% if yak_extra_env is defined %}

# Deployment-specific overrides for the Yak app itself (e.g. raising
# YAK_MAX_BUDGET_PER_TASK when using a Claude subscription instead of
# pay-per-token). Unlike agent_extra_env these are NOT forwarded into
# sandboxes — they only configure the Yak container's own process.
{% for key, value in yak_extra_env.items() %}
{{ key }}={{ value }}
{% endfor %}
{% endif %}

# Host, request and queue metrics for the System page, pushed to telemetryd.
TELEMETRY_SERVICE_NAME=yak
TELEMETRY_STORE=redis
TELEMETRY_EXPORTERS=otlp
TELEMETRY_OTLP_ENDPOINT=http://{{ telemetryd_container_name }}:4319
TELEMETRY_OTLP_TOKEN={{ telemetryd_ingest_token }}
TELEMETRY_PROMETHEUS_ENABLED=false
QUEUE_METRICS_STORAGE=redis
QUEUE_METRICS_TELEMETRY_ENABLED=true
QUEUE_METRICS_PROMETHEUS_ENABLED=false
TELEMETRY_UI_METRICS_URL=http://{{ telemetryd_container_name }}:4319
TELEMETRY_UI_TEMPO_URL=http://{{ telemetryd_container_name }}:4319
TELEMETRY_UI_LOKI_URL=http://{{ telemetryd_container_name }}:4319
TELEMETRY_UI_TOKEN={{ telemetryd_query_token }}

{% if yak_jump_host_key_fingerprint_result is defined and yak_jump_host_key_fingerprint_result.rc == 0 %}
# SHA256 fingerprints of the jump host keys, printed by `yak ssh`. Comma separated.
YAK_SSH_JUMP_HOST_KEY_FINGERPRINTS={{ yak_jump_host_key_fingerprint_result.stdout.split()[1] }}
{% endif %}
