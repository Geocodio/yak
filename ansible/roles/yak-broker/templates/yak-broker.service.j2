[Unit]
Description=Yak pipe broker
After=network-online.target docker.service incus.service
Wants=network-online.target

[Service]
# An unprivileged user in incus-admin: enough for `incus exec`, and the only
# user the app's credential socket admits.
User={{ yak_broker_user }}
Group={{ yak_broker_user }}
Environment=HOME=/var/lib/yak-broker
NoNewPrivileges=true
EnvironmentFile=/etc/yak/broker.env
ExecStart=/usr/local/bin/yak-broker
Restart=always
RestartSec=2
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
