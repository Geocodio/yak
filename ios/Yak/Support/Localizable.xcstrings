    },
    "connect.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yak runs on your company's own server. Pair this device with it to work on your threads from anywhere."
          }
        }
      }
    },
    "connect.hint1.title": {
      "localizations": {
        "en": {
          "stringUnit": {
