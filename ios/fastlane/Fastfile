default_platform(:ios)

IOS_ROOT = File.expand_path("..", __dir__)

platform :ios do
  desc "Generate the Xcode project from project.yml"
  lane :generate do
    config = File.join(IOS_ROOT, "Config.xcconfig")
    example = File.join(IOS_ROOT, "Config.example.xcconfig")
    FileUtils.cp(example, config) unless File.exist?(config)
    sh("cd #{IOS_ROOT.shellescape} && xcodegen generate")
  end

  desc "Format check and project rules"
  lane :lint do
    sh("cd #{IOS_ROOT.shellescape} && swift format lint --strict --recursive Yak YakTests YakUITests Packages")
    sh("#{File.join(IOS_ROOT, "scripts/check-rules.sh").shellescape}")
  end

  desc "UI smoke tests against the stub server: fastlane ui_smoke device:\"iPhone Duo\""
  lane :ui_smoke do |options|
    device = options[:device] || "iPhone 18 Pro"
    generate
    stub_package = File.join(IOS_ROOT, "Packages/YakStub")
    sh("cd #{stub_package.shellescape} && swift build -c release -Xswiftc -warnings-as-errors")
    stub_binary = File.join(`cd #{stub_package.shellescape} && swift build -c release --show-bin-path`.strip, "yak-stub")
    build_directory = File.join(IOS_ROOT, "build")
    FileUtils.mkdir_p(build_directory)
    log_path = File.join(build_directory, "yak-stub.log")
    # Port 0 lets the stub pick a free port; it prints the port it got on its first line.
    output_path = File.join(build_directory, "yak-stub.out")
    stub_pid = Process.spawn(
      stub_binary, "--port", "0", "--fixtures", File.join(IOS_ROOT, "fixtures"), "--scenario", "paired",
      out: output_path, err: log_path
    )
    begin
      port = nil
      50.times do
        port = File.read(output_path)[/listening on 127\.0\.0\.1:(\d+)/, 1]
        break if port
        sleep 0.2
      end
      UI.user_error!("yak-stub did not start, see #{log_path}") unless port
      result_path = File.join(build_directory, "ui-smoke-#{device.gsub(/\W+/, "-")}.xcresult")
      FileUtils.rm_rf(result_path)
      sh(
        "cd #{IOS_ROOT.shellescape} && TEST_RUNNER_YAK_STUB_PORT=#{port} xcodebuild test -project Yak.xcodeproj -scheme Yak " \
        "-destination #{"platform=iOS Simulator,name=#{device}".shellescape} -only-testing:YakUITests " \
        "-resultBundlePath #{result_path.shellescape} SWIFT_TREAT_WARNINGS_AS_ERRORS=YES CODE_SIGNING_ALLOWED=NO"
      )
    ensure
      Process.kill("TERM", stub_pid)
      Process.wait(stub_pid)
    end
  end

  desc "YakKit package tests and app unit tests"
  lane :test do
    generate
    sh("cd #{File.join(IOS_ROOT, "Packages/YakKit").shellescape} && swift test -Xswiftc -warnings-as-errors")
    sh("cd #{File.join(IOS_ROOT, "Packages/YakStub").shellescape} && swift test -Xswiftc -warnings-as-errors")
    sh(
      "cd #{IOS_ROOT.shellescape} && xcodebuild test -project Yak.xcodeproj -scheme Yak " \
      "-destination 'platform=iOS Simulator,name=iPhone 18 Pro' -only-testing:YakTests " \
      "SWIFT_TREAT_WARNINGS_AS_ERRORS=YES CODE_SIGNING_ALLOWED=NO"
    )
  end
end
