# Wayfinder helper folders for routes that vendor packages register
# (framework, Fortify, Inertia, Boost, cboxdk ...). Yak calls none of
# them, and the Vite plugin regenerates them on every build. The
# top-level routes/index.ts stays tracked: it mixes Yak's own routes
# with Fortify's login and logout.
/resources/js/actions/*
!/resources/js/actions/App/
/resources/js/routes/boost/
/resources/js/routes/login/
/resources/js/routes/password/
/resources/js/routes/prometheus/
/resources/js/routes/queue-metrics/
/resources/js/routes/storage/
/resources/js/routes/telemetry/
/resources/js/routes/telemetry-ui/
broker/dist/
runner/dist/
/ansible/vault/next.yml
/ansible/inventory/next.yml
/storage/artifacts/
