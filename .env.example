APP_NAME=Yak
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yak
DB_USERNAME=yak
DB_PASSWORD=yak

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Host and queue metrics for the System page. Needs Redis and telemetryd;
# off by default for local development.
TELEMETRY_ENABLED=false
QUEUE_METRICS_ENABLED=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Outbound through Postmark: MAIL_MAILER=postmark
POSTMARK_API_KEY=
POSTMARK_MESSAGE_STREAM_ID=outbound

# Email channel (Postmark inbound webhook to /webhooks/email)
YAK_EMAIL_WEBHOOK_PASSWORD=
YAK_EMAIL_INBOUND_ADDRESS=
YAK_EMAIL_REPLY_TO=
YAK_EMAIL_REQUIRE_DKIM=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ALLOWED_DOMAINS=

# Video walkthrough rendering
# YAK_VIDEO_RENDER_STAGING_PATH=/data/render  (default: storage/app/private/render)
YAK_VIDEO_RAW_RETENTION_DAYS=30
# Shoot viewport handed to `yak-browser shoot` (composition height is width-derived + 52px bar)
YAK_VIDEO_WIDTH=1440
YAK_VIDEO_HEIGHT=900
# RenderQaCheck duration gate, in seconds
YAK_VIDEO_MIN_SECONDS=30
YAK_VIDEO_MAX_SECONDS=180

# Optional: walkthrough voiceover (ElevenLabs text-to-speech). Leave unset to
# render walkthroughs with captions only.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=UgBBYS2sOqTuMpoF3BR0

# GitHub App user authorization, used to link a user's GitHub account from
# Settings > Profile. Find both on the GitHub App settings page.
YAK_GITHUB_APP_CLIENT_ID=
YAK_GITHUB_APP_CLIENT_SECRET=

# Optional: token used when installing a private plugin marketplace from the
# /skills page. Unset falls back to the GitHub App installation token.
# YAK_SKILLS_GITHUB_TOKEN=

VITE_APP_NAME="${APP_NAME}"

# Telemetry (local-only usage and performance metrics; feeds /analytics)
YAK_TELEMETRY_ENABLED=true
YAK_TELEMETRY_RETENTION_DAYS=90

YAK_SLACK_FEED_CHANNEL=

# Threads
YAK_THREADS_TURN_GRACE_SECONDS=30
YAK_THREADS_TURN_WALL_CLOCK_MINUTES=240
YAK_THREADS_PAUSE_TO_STOP_MINUTES=30
YAK_THREADS_STOP_TO_DESTROY_HOURS=72
YAK_THREADS_DESTROY_DAYS=30
YAK_THREADS_SESSION_RETENTION_DAYS=30
YAK_THREADS_STREAM_CATCHUP_MINUTES=10
YAK_THREADS_AWAKE_CAP=8
YAK_THREADS_PERSON_AWAKE_CAP=4
YAK_THREADS_MEMORY_FLOOR_GB=8
YAK_THREADS_POOL_WATERMARK_PERCENT=80
YAK_THREADS_EVICTION_GRACE_MINUTES=10
YAK_THREADS_STOP_TIMEOUT_SECONDS=60
YAK_THREADS_WAKE_PAUSE_GRACE_MINUTES=5
YAK_THREADS_CHILD_AWAKE_LIMIT=3
YAK_THREADS_CHILD_RESULT_WAIT_MINUTES=10
YAK_THREADS_PAIR_MESSAGE_THROTTLE_PER_MINUTE=6
YAK_THREADS_STACK_ALERT_TURNS=50
YAK_THREADS_STACK_ALERT_HOURS=3
YAK_THREADS_STACK_ALERT_CHILDREN=12
YAK_THREADS_ACCOUNT_MAX_CONCURRENT_TURNS=16
YAK_THREADS_RUNNER_RESTART_CAP=3
YAK_THREADS_DIFF_MAX_BYTES=1048576
# YAK_THREADS_SESSION_STORE_PATH=  (default: storage/app/session-store)
YAK_SESSION_STORE_KEY=
YAK_THREADS_CREDENTIAL_SOCKET=/run/yak/credentials.sock
YAK_THREADS_AUTH_PROXY_URL=http://10.100.0.1:8787
YAK_THREADS_PREVIEW_HOLD_SECONDS=10
YAK_THREADS_PREVIEW_ACTIVITY_MINUTES=5
YAK_THREADS_PREVIEW_SAFARI_FALLBACK=true

# Reverb (WebSockets)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

YAK_TELEPORT_EXPIRY_MINUTES=30
YAK_TELEPORT_COMPLETE_WAIT_SECONDS=30
YAK_TELEPORT_HELD_EVENT_TINT_HOURS=24

# Web push. Generate keys with: php artisan webpush:vapid
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
