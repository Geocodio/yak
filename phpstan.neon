includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app/
    level: 8
    # phpstan-baseline.neon is do-not-touch and still carries ignoreErrors
    # entries for app/Livewire/* classes removed in this cleanup; without
    # this, PHPStan fails on those entries as "unmatched ignored errors".
    reportUnmatchedIgnoredErrors: false
