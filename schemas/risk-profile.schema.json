{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Geocodio/yak/main/schemas/risk-profile.schema.json",
  "title": "Yak risk profile (.yak/risk-profile.yml)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "enum": [1, 2],
      "description": "The file format version. 1 describes path-based areas, 2 describes plain-language concerns."
    },
    "concerns": {
      "type": "array",
      "description": "Version 2 only. Kinds of change a human must look at before Yak approves.",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "description": "A unique name for the concern."
          },
          "approval": {
            "enum": ["always_human", "when_tested"],
            "description": "always_human: never approve a change that touches it. when_tested: approve only when the change includes a test."
          },
          "description": {
            "type": "string",
            "maxLength": 1000,
            "description": "What kind of change counts as touching the concern."
          }
        },
        "required": ["name", "approval", "description"]
      }
    },
    "areas": {
      "type": "array",
      "description": "The areas of the codebase and their risk.",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "description": "One area of the codebase and how risky it is to change.",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "description": "A unique name for the area."
          },
          "paths": {
            "type": "array",
            "description": "Path globs that belong to the area.",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "string",
              "maxLength": 500,
              "pattern": "^[A-Za-z0-9_./*?\\-]+$"
            }
          },
          "symbols": {
            "type": "array",
            "description": "Functions or classes that belong to the area. May be an empty list.",
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical",
              "unknown"
            ],
            "description": "How risky changes to the area are."
          },
          "rationale": {
            "type": "string",
            "maxLength": 4000,
            "description": "Why the area has this risk level."
          },
          "evidence": {
            "type": "array",
            "description": "Facts from the repository that support the rationale.",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          }
        },
        "required": [
          "name",
          "paths",
          "symbols",
          "risk",
          "rationale",
          "evidence"
        ]
      }
    },
    "unknowns": {
      "type": "array",
      "description": "Questions Yak could not answer and a human should check.",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    }
  },
  "oneOf": [
    {
      "properties": { "version": { "const": 1 } },
      "required": ["version", "areas"],
      "not": { "required": ["concerns"] }
    },
    {
      "properties": { "version": { "const": 2 } },
      "required": ["version", "concerns"],
      "not": {
        "anyOf": [{ "required": ["areas"] }, { "required": ["unknowns"] }]
      }
    }
  ]
}
